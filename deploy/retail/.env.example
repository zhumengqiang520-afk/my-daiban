# Copy to .env, replace every CHANGE_ME value, then keep .env outside Git.
# Before an IP certificate is issued: SITE_ADDRESS=http://101.132.17.166 and PUBLIC_URL=http://101.132.17.166/
# After scripts/issue-ip-certificate.sh succeeds, use the IP HTTPS values documented in QUICKSTART.
# With a domain: SITE_ADDRESS=tasks.example.com and PUBLIC_URL=https://tasks.example.com/
SITE_ADDRESS=CHANGE_ME.example.com
PUBLIC_URL=https://CHANGE_ME.example.com/
SOURCE_CODE_URL=https://github.com/CHANGE_ME/my-daiban
APP_IMAGE=ghcr.io/CHANGE_ME/my-daiban
POSTGRES_IMAGE=ghcr.io/CHANGE_ME/my-daiban:postgres-16.14-alpine3.22
CADDY_IMAGE=ghcr.io/CHANGE_ME/my-daiban:caddy-2.11.4-alpine
CERTBOT_IMAGE=ghcr.io/CHANGE_ME/my-daiban:certbot-5.4.0
IMAGE_TAG=2026.08.1
APP_UID=1000
APP_GID=1000

POSTGRES_DB=retail_tasks
POSTGRES_USER=retail_tasks
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
SERVICE_SECRET=CHANGE_ME_64_CHARACTER_RANDOM_SECRET

# Keep false after the organization-owner accounts have been created with the CLI.
ENABLE_REGISTRATION=false
